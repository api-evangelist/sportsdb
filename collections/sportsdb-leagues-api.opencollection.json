          },
          "http": {
            "method": "GET",
            "url": "https://www.thesportsdb.com/api/v1/json/:apiKey/lookuptable.php",
            "params": [
              {
                "name": "apiKey",
                "value": "",
                "type": "path",
                "description": "API key path segment. The free test key is \"3\" (also documented as \"123\")."
              },
              {
                "name": "l",
                "value": "",
                "type": "query",
                "description": "League ID (idLeague)."
              },
              {
                "name": "s",
                "value": "",
                "type": "query",
                "description": "Season."
              }
            ]
          },
